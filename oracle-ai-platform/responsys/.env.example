# Copy to .env.local for local development (npm run setup:local writes one for you).
# Never commit real secrets. Production should use a secret manager.

NODE_ENV=development
APP_DATA_MODE=development            # production | development | test (demo is refused in production)
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL: runtime (non-owner, RLS-enforced) and migration (owner) connections
DATABASE_URL=postgres://rci_app:CHANGE_ME@localhost:5432/rci_dev
DATABASE_MIGRATION_URL=postgres://rci_owner:CHANGE_ME@localhost:5432/rci_dev
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_TTL_HOURS=12

# Identity: oidc in production; dev is a local sign-in harness and is refused in production
AUTH_MODE=dev
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ALLOW_WORKSPACE_CREATION=true

# Private file storage for uploads
STORAGE_DRIVER=filesystem
STORAGE_ROOT=./var/objects
UPLOAD_MAX_BYTES=10485760

# AI (off by default; answers are then rule-based and labeled as such)
AI_PROVIDER=none                     # none | gemini | nvidia | openai
AI_MODEL=                            # required when AI_PROVIDER=gemini
AI_FALLBACK_MODEL=                   # optional: second model used only when AI_MODEL is busy/over quota (list with npm run ai:models)
GEMINI_API_KEY=
# OpenAI / ChatGPT provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# NVIDIA API catalog (OpenAI-compatible). With AI_PROVIDER=gemini these act as the backup when Gemini
# is busy; with AI_PROVIDER=nvidia they are the main AI. Set them with: npm run ai:nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=8192
AI_DAILY_RUN_LIMIT_PER_WORKSPACE=200

# Responsys (credentials are referenced, e.g. env:MAIN -> RESPONSYS_MAIN_USERNAME/_PASSWORD)
RESPONSYS_ALLOWED_HOST_SUFFIXES=.responsys.net,.responsys.ocs.oraclecloud.com
RESPONSYS_CREDENTIALS_FILE=
# RESPONSYS_MAIN_USERNAME=
# RESPONSYS_MAIN_PASSWORD=
SYNC_METADATA_INTERVAL_MINUTES=15
SYNC_REPORTING_INTERVAL_MINUTES=15
SYNC_RECONCILIATION_LOOKBACK_DAYS=14

# Kill switches for external actions (keep false unless explicitly authorized)
ENABLE_PROVIDER_DRAFT_WRITES=false
ENABLE_PROOF_SENDS=false
ENABLE_LIVE_CAMPAIGN_SENDS=false

# Run the job worker inside the API process (handy locally; use npm run start:worker in production)
RUN_WORKER_IN_PROCESS=true
LOG_LEVEL=info
