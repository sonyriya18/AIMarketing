{
  "name": "responsys-campaign-intelligence",
  "private": true,
  "version": "1.0.0",
  "description": "Responsys Campaign Intelligence: evidence-backed campaign analytics on real uploaded and Responsys data",
  "type": "module",
  "scripts": {
    "setup:local": "tsx scripts/setup-local.ts",
    "ai:key": "tsx scripts/set-ai-key.ts",
    "ai:models": "tsx scripts/list-ai-models.ts",
    "ai:test": "tsx scripts/test-ai.ts",
    "ai:nvidia": "tsx scripts/set-nvidia-key.ts",
    "roles": "tsx scripts/workspace-roles.ts",
    "dev": "tsx server/dev.ts",
    "dev:worker": "tsx server/worker.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:embed": "tsx scripts/embed-migrations.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "lint": "npm run typecheck && tsx scripts/verify-no-demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "build": "vite build && tsx scripts/build-server.ts",
    "build:web": "vite build",
    "start": "npm run start:api",
    "start:api": "node dist-server/index.js",
    "start:worker": "node dist-server/worker.js",
    "db:migrate:prod": "node dist-server/migrate.js",
    "verify:no-demo": "tsx scripts/verify-no-demo.ts",
    "verify:production": "tsx scripts/verify-production.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.2",
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
