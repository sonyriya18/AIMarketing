{
  "name": "oracle-ai-assessment-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts server/worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server && esbuild scripts/migrate.ts scripts/verify-production.ts scripts/retention.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server",
    "start": "node dist-server/index.js",
    "worker": "node dist-server/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "node -e \"if(!process.env.TEST_DATABASE_URL){console.error('Set TEST_DATABASE_URL to a fresh test database provisioned with npm run db:migrate, as the runtime role.');process.exit(1)}\" && vitest run tests/api.test.ts tests/postgres-rls.test.ts",
    "test:e2e": "playwright test",
    "verify:production": "tsx scripts/verify-production.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "retention": "tsx scripts/retention.ts",
    "format": "prettier --write server src shared scripts tests *.ts *.json",
    "examples": "node scripts/synthetic-examples.mjs",
    "docs": "tsx scripts/generate-docs.ts",
    "responsys:link": "node scripts/link-responsys.mjs",
    "ai:check": "tsx scripts/check-ai.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "csv-parse": "^6.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "openid-client": "^6.8.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.10.1",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
