# Oracle AI Assessment Platform (Eloqua, Unity, Infinity). Copy to .env and never commit or share it.
# This is a separate project: never use the Responsys database or its secrets here.
NODE_ENV=development
PORT=3006
APP_ORIGIN=http://localhost:3006
# dev = local email sign-in (development only). Production requires oidc.
AUTH_MODE=dev
# Leave blank locally to use the durable embedded database in .data/postgres.
# Production: runtime-role connection string of a separate, managed PostgreSQL database.
DATABASE_URL=
# Only for the one-off `npm run db:migrate` process. Never set on the web or worker.
DATABASE_MIGRATION_URL=
RUNTIME_DATABASE_ROLE=enterprise_runtime
RUNTIME_DATABASE_PASSWORD=
DATA_DIR=.data
# Production: at least 32 random characters / a base64 32-byte key. Generated locally if blank.
SESSION_SECRET=
ENCRYPTION_KEY=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Your organization
# Platform provider administrators (comma separated): they create client companies and choose
# each company's subscribed tools. BOOTSTRAP_EMAIL is always one. Locally, if both are empty, the
# first person to sign in becomes the provider administrator.
BOOTSTRAP_EMAIL=
PLATFORM_ADMIN_EMAILS=
# Local: the folder of your Responsys v17 app (already set up with npm ci + npm run setup:local).
# The platform starts it and serves it at http://responsys.localhost:3006 with the same sign-in.
# Empty = use the "responsys" folder inside this platform folder; "off" = do not start v17.
RESPONSYS_DIR=
# The AI key below (Gemini or ChatGPT) is also given to Responsys v17. false = v17 keeps its own.
RESPONSYS_SHARE_AI=true
# Default address of the unmodified Responsys v17 app (a company can have its own, set by the provider).
RESPONSYS_URL=
# Single sign-on secret shared with Responsys v17 (its OIDC_CLIENT_SECRET). At least 32 characters.
# Generated automatically when RESPONSYS_DIR is used. Never commit or share it.
RESPONSYS_SSO_SECRET=
# Exact approved hosts, comma separated, no wildcards. Examples:
#   login.eloqua.com,secure.p0X.eloqua.com,<unity tenant host>,<infinity host>,generativelanguage.googleapis.com
OUTBOUND_HOSTS=
# Office network proxy, only if ChatGPT cannot be reached and IT gives you a proxy address,
# e.g. http://proxy.example.com:8080 (2-START.cmd already uses the Windows proxy setting).
HTTPS_PROXY=
# AI_PROVIDER = none | gemini | openai (ChatGPT) | openai-compatible (other endpoint, set AI_BASE_URL).
# "none" shows labeled rule-based guidance. The same key is also used by Responsys v17.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_MS=30000
AI_DAILY_LIMIT=100
# Local dev server runs the worker in-process. Production runs `npm run worker` separately.
RUN_WORKER=false
# Set to 1 only when reachable exclusively through exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
RETENTION_DAYS=90
